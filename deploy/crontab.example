# Install as the deploy user: crontab deploy/crontab.example
# Host timezone must be Asia/Shanghai (see deploy/tencent-lighthouse.md).
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
TZ=Asia/Shanghai

# Collect after the close. A-share data vendors finish updating ~17:00-18:00 CST.
30 18 * * 1-5 cd /opt/finagent && /usr/bin/docker compose run --rm app python scripts/collect_daily.py >> logs/cron.log 2>&1

# Freshness / null-ratio check. It must run after collect and before risk and
# growth: both read health_<date>.json, and a missing file downgrades the risk
# check to info instead of failing it. Alerts go to Feishu on errors.
38 18 * * 1-5 cd /opt/finagent && /usr/bin/docker compose run --rm app python scripts/health_check.py --alert feishu >> logs/cron.log 2>&1

# Factor report: reads the cache written above, no network. Writes
# data/factors/<date>.parquet and data/quality/factor_report_<date>.json.
40 18 * * 1-5 cd /opt/finagent && /usr/bin/docker compose run --rm app python -m finagent.cli factor-report >> logs/cron.log 2>&1

# Structured signals + prediction ledger. Settles matured predictions first,
# then writes data/signals/<date>.json and appends to data/predictions/.
45 18 * * 1-5 cd /opt/finagent && /usr/bin/docker compose run --rm app python -m finagent.cli signals >> logs/cron.log 2>&1

# Target weights and the Phase 7 risk verdict. Both read the cache, no network.
# Portfolio writes data/portfolio/<date>.json; risk writes
# data/quality/risk_<date>.json and exits 1 when a hard limit is breached.
47 18 * * 1-5 cd /opt/finagent && /usr/bin/docker compose run --rm app python -m finagent.cli portfolio >> logs/cron.log 2>&1
48 18 * * 1-5 cd /opt/finagent && /usr/bin/docker compose run --rm app python -m finagent.cli risk >> logs/cron.log 2>&1

# Phase 6 narrative report. It reads the signals/portfolio/factor/risk
# artefacts above and writes data/reports/report_<date>.md|json. With
# DEEPSEEK_API_KEY it calls the LLM; without it the deterministic template is
# written and the JSON records why it fell back.
50 18 * * 1-5 cd /opt/finagent && /usr/bin/docker compose run --rm app python -m finagent.cli report >> logs/cron.log 2>&1

# Phase 8-10 growth loop. Daily state reads the artefacts above and writes
# data/growth/growth_<date>.json. Journal review settles matured human
# decisions; it never creates one. The weekly review writes
# data/growth/review_<date>.md|json with lessons and next actions.
55 18 * * 1-5 cd /opt/finagent && /usr/bin/docker compose run --rm app python -m finagent.cli growth >> logs/cron.log 2>&1
5 19 * * 1-5 cd /opt/finagent && /usr/bin/docker compose run --rm app python -m finagent.cli journal --review >> logs/cron.log 2>&1
30 3 * * 0 cd /opt/finagent && /usr/bin/docker compose run --rm app python -m finagent.cli growth --review --window 30 >> logs/cron.log 2>&1

# Weekly audit backup: snapshots, quality reports, factor panels and configs.
# Cache is regenerable and deliberately excluded. Keep 8 weeks.
0 3 * * 0 cd /opt/finagent && tar czf backups/finagent-$(date +\%F).tgz data/snapshots data/quality data/factors data/signals data/predictions data/portfolio data/reports data/growth data/journal configs && find backups -type f -name 'finagent-*.tgz' -mtime +56 -delete
