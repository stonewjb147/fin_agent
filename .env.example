# Copy to .env on the server, fill in the real values, chmod 600.
# Feishu fields are needed for Phase 1 alerts. The Phase 6 report works without
# DeepSeek too: with no key it writes the deterministic template instead.

FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Container uid/gid. Keep 1000 (the image's appuser) if your deploy user is
# uid 1000; otherwise set these to `id -u` / `id -g` and make ./data, ./logs,
# ./backups owned by the same ids.
FINAGENT_UID=1000
FINAGENT_GID=1000

# Optional Phase 6 narrative report. Keep the key out of git and logs.
# DEEPSEEK_BASE_URL defaults to https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# FINAGENT_LLM_MODEL=deepseek-chat
