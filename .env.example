# Copy to .env on the server, fill in the real values, chmod 600.
# Only the Feishu fields are needed for the Phase 1 deployment.

FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Container uid/gid. Keep 1000 (the image's appuser) if your deploy user is
# uid 1000; otherwise set these to `id -u` / `id -g` and make ./data, ./logs,
# ./backups owned by the same ids.
FINAGENT_UID=1000
FINAGENT_GID=1000
